<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>HungryPathing.Tests</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The planner has no game dependencies, so the checks compile it directly and run without the game. -->
    <Compile Include="../source/Planning/*.cs" Link="Planning/%(Filename)%(Extension)" />
    <!-- The circuit breaker's wiring runs as shipped against the stand-ins in Stubs.cs for the settings and the log. -->
    <Compile Include="../source/Safety.cs" Link="Mod/Safety.cs" />
    <!-- So does the Timber Together bridge, against the stand-in in Stubs.cs for Timber Together's ColonyWorkingHours. -->
    <Compile Include="../source/MultiColonyBridge.cs" Link="Mod/MultiColonyBridge.cs" />
    <!-- The reset the configurator runs at every load, so the checks re-arm both switches the way the game does. -->
    <Compile Include="../source/GameLoad.cs" Link="Mod/GameLoad.cs" />
    <!-- What the in-game notice says about the two switches, and when; the dialog itself needs the game. -->
    <Compile Include="../source/SwitchedOff.cs" Link="Mod/SwitchedOff.cs" />
    <Compile Include="../source/Stats.cs" Link="Mod/Stats.cs" />
  </ItemGroup>
</Project>
